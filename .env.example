# Copia in .env.local e compila. NON committare i valori reali (.env.local è gitignored).

# Chiave API del chatbot (OBBLIGATORIA per le risposte AI).
# Si crea su https://console.anthropic.com
ANTHROPIC_API_KEY=

# Rate limit DISTRIBUITO del chatbot (OPZIONALE, consigliato in produzione).
# Crea un database Redis gratuito su https://upstash.com e incolla qui i due
# valori "REST". Senza queste variabili il rate limit resta in-memory (per
# istanza serverless, si azzera ai cold start). Mettile anche su Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL pubblico del sito (OPZIONALE): sovrascrive il default wowspaceweb.com
# in canonical, sitemap e dati strutturati. Utile per staging/preview.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 (OPZIONALE). Con l'ID impostato, GA parte SOLO dopo che
# il visitatore accetta "statistiche" nel banner cookie (IP anonimizzato,
# niente signals pubblicitari). Senza ID: nessuna richiesta, nessun cookie.
# Si crea su https://analytics.google.com → ID tipo G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
